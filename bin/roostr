#!/usr/bin/env node
'use strict';
// roostr entry point.
//   roostr [board options]   the live board (see --help)
//   roostr report ...        report exact usage for a pane
//   roostr recommend ...     recommend optimal model and effort for a task
//   roostr spawn ...         record a spawn recommendation
//   roostr outcome ...       record how a run ended
//   roostr summary [...]     aggregate the orchestration ledger
//   roostr tasks [...]       validate the machine readable task list
//   roostr template <role>   print a role template
//   roostr name [...]        draw worker names from the head language
//   roostr backups [...]     list, show, capture or restore a workspace backup
//   roostr handoff [...]     write a handoff brief for an agent pane
//   roostr workers [...]     publish a worker snapshot for the board
//   roostr onboard [...]     run the orchestrator onboarding bundle
//   roostr analytics [...]   query continuous usage and cost attribution
//   roostr arena [...]       the shareable first-try pass leaderboard
//   roostr init [...]        prepare a project for roostr in one command
//   roostr sessions [...]    list the sessions saved before a restart
//   roostr log [...]         recent agent sessions, reopen one after a closed tab
//   roostr restore [...]     print the restore plan
//   roostr respawn [...]     rebuild a workspace and resume its sessions
//   roostr registry [...]    the standalone worker registry and tokens
//   roostr governor [...]    placement policy, pane budget and idle reaper
//   roostr run [...]         launch and track a detached headless worker

const path = require('path');

const argv = process.argv.slice(2);
const src = path.join(__dirname, '..', 'src');

const versionArg = argv[0] === 'board' ? argv[1] : argv[0];
if (versionArg === '--version' || versionArg === '-v') {
  const binaryName = path.basename(process.argv[1]) || 'roostr';
  process.stdout.write(`${binaryName} ${require(path.join(src, 'version.js')).VERSION}\n`);
  process.exit(0);
}

if (argv[0] === 'report') {
  process.exitCode = require(path.join(src, 'report.js')).main(argv.slice(1));
} else if (argv[0] === 'recommend') {
  process.exitCode = require(path.join(src, 'advisor.js')).main(argv.slice(1));
} else if (argv[0] === 'spawn') {
  const p = require(path.join(src, 'orchestrator.js')).mainSpawn(argv.slice(1));
  if (p && typeof p.then === 'function') {
    p.then((code) => { process.exitCode = code || 0; }).catch((e) => {
      process.stderr.write(`roostr spawn: ${e.message}\n`);
      process.exitCode = 1;
    });
  } else {
    process.exitCode = p || 0;
  }
} else if (argv[0] === 'outcome' || argv[0] === 'ledger') {
  process.exitCode = require(path.join(src, 'ledger.js')).main(argv[0] === 'ledger' ? argv.slice(1) : argv);
} else if (argv[0] === 'summary') {
  process.exitCode = require(path.join(src, 'summary.js')).main(argv.slice(1));
} else if (argv[0] === 'analytics') {
  process.exitCode = require(path.join(src, 'analytics.js')).main(argv.slice(1));
} else if (argv[0] === 'arena') {
  process.exitCode = require(path.join(src, 'arena.js')).runCli(argv.slice(1));
} else if (argv[0] === 'init') {
  process.exitCode = require(path.join(src, 'init.js')).runInit(argv.slice(1));
} else if (argv[0] === 'tasks') {
  process.exitCode = require(path.join(src, 'tasks.js')).main(argv.slice(1));
} else if (argv[0] === 'template') {
  process.exitCode = require(path.join(src, 'templates.js')).main(argv.slice(1));
} else if (argv[0] === 'name') {
  process.exitCode = require(path.join(src, 'names.js')).main(argv.slice(1));
} else if (argv[0] === 'sessions') {
  process.exitCode = require(path.join(src, 'sessions.js')).mainSessions(argv.slice(1));
} else if (argv[0] === 'backups') {
  require(path.join(src, 'backup.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr backups: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'handoff') {
  process.exitCode = require(path.join(src, 'handoff.js')).main(argv.slice(1));
} else if (argv[0] === 'workers') {
  require(path.join(src, 'workers.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr workers: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'onboard') {
  require(path.join(src, 'onboard.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr onboard: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'log') {
  require(path.join(src, 'session-log.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr log: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'respawn') {
  require(path.join(src, 'respawn.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr respawn: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'restore') {
  const p = require(path.join(src, 'restore.js')).main(argv.slice(1));
  if (p && typeof p.then === 'function') {
    // process.exit here can truncate a piped plan; exitCode lets stdout drain.
    p.then((code) => { process.exitCode = code || 0; }).catch(() => { process.exitCode = 1; });
  } else {
    process.exitCode = p || 0;
  }
} else if (argv[0] === 'registry') {
  process.exitCode = require(path.join(src, 'registry.js')).main(argv.slice(1));
} else if (argv[0] === 'governor') {
  require(path.join(src, 'governor.js')).main(argv.slice(1))
    .then((code) => { process.exitCode = code || 0; }, (e) => { process.stderr.write(`roostr governor: ${e.message}\n`); process.exitCode = 1; });
} else if (argv[0] === 'run') {
  // Lazy require so the headless runner can be developed in parallel; a repo
  // without src/runner.js still boots and reports a clean error.
  let runner;
  try {
    runner = require(path.join(src, 'runner.js'));
  } catch (e) {
    process.stderr.write('roostr run: headless runner not available (src/runner.js missing)\n');
    process.exit(1);
  }
  const p = runner.main(argv.slice(1));
  if (p && typeof p.then === 'function') {
    p.then((code) => { process.exitCode = code || 0; }).catch((e) => { process.stderr.write(`roostr run: ${e.message}\n`); process.exitCode = 1; });
  } else {
    process.exitCode = p || 0;
  }
} else {
  const args = argv[0] === 'board' ? argv.slice(1) : argv;
  require(path.join(src, 'board.js')).main(args).then(async (code) => {
    if (code === 0 && (args.includes('--json') || args.includes('--json-rows'))) {
      try {
        const herdr = require(path.join(src, 'herdr.js'));
        const sessions = require(path.join(src, 'sessions.js'));
        const snap = await herdr.snapshot();
        await sessions.resolveAgentSessions(snap, { herdr, writeBack: false }).catch(() => {});
        sessions.saveSessions(snap);
      } catch (_) {}
    }
    process.exitCode = code;
  });
}
